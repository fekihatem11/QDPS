# Cluster settings for the SLURM scripts under qdps/retrain/.
# Copy this file to .env at the repository root and fill in your own values.
# .env is ignored by git; only this example is tracked.

# SLURM allocation account charged for the jobs (read natively by sbatch).
SBATCH_ACCOUNT=def-yourgroup

# Durable project directory on the cluster. It must contain the Python
# virtualenv (.venv/) and the retraining assets (retrain/).
QDPS_PROJECT_DIR=/project/def-yourgroup/yourusername/QDPS
